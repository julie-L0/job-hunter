# 飞书 bitable（数据）
BITABLE_APP_TOKEN=
BITABLE_TABLE_COMPANY=
BITABLE_TABLE_MAIN=
BITABLE_TABLE_EXPERIENCE=
BITABLE_TABLE_RESUME=
BITABLE_TABLE_PREFERENCE=

# 飞书自建应用凭证（在开放平台后台取，用来换 tenant_access_token）
# 这个应用必须已被加为该 bitable 的协作者（full_access），否则写入报 91403
LARK_APP_ID=
LARK_APP_SECRET=

# 接收准备文档权限的用户 open_id；不使用准备文档时可留空
LARK_USER_OPEN_ID=
# 准备文档目录可留空；URL 前缀替换为自己的飞书租户域名
LARK_DOC_FOLDER_TOKEN=
LARK_DOC_URL_BASE=https://your-tenant.feishu.cn/docx/

# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 置 1 强制走占位回复，不调真实接口
LLM_MOCK=

# 置 1 用内存假数据替代飞书，不连飞书也能开发和验收前端（重启即清空）。
# Vercel 上会被 !process.env.VERCEL 挡掉，线上永远不可能读到假数据
LARK_MOCK=

# 公网访问口令。部署到 Vercel 前必须设置为高强度随机值；未设置时公网受保护接口拒绝访问
APP_PASSWORD=

PORT=3000
