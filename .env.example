# 飞书 bitable（数据）
BITABLE_APP_TOKEN=B3jqb8GDCa0oBQsckY9chlFTn6f
BITABLE_TABLE_MAIN=tblKAcj7wrYoNk7V
BITABLE_TABLE_EXPERIENCE=tblPVjAP0AJzYmKt
BITABLE_TABLE_RESUME=tblK5eg0TEcC8jJp

# 飞书自建应用凭证（在开放平台后台取，用来换 tenant_access_token）
# 这个应用必须已被加为该 bitable 的协作者（full_access），否则写入报 91403
LARK_APP_ID=cli_aa9fe5cc7ce49cd7
LARK_APP_SECRET=

# lijue 本人的 open_id，用来把应用创建的准备文档授权给她本人，不然打开自己的链接会 403
LARK_USER_OPEN_ID=ou_814d9f9a0eab93d50300122f9079bc01
# 准备文档放到哪个飞书文件夹（可留空，留空则在应用空间里，靠上面的授权访问）
LARK_DOC_FOLDER_TOKEN=
LARK_DOC_URL_BASE=https://mcn6uafh559t.feishu.cn/docx/

# LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 置 1 强制走占位回复，不调真实接口
LLM_MOCK=

# 置 1 用内存假数据替代飞书，不连飞书也能开发和验收前端（重启即清空）。
# Vercel 上会被 !process.env.VERCEL 挡掉，线上永远不可能读到假数据
LARK_MOCK=

# 公网访问口令。部署到 Vercel 前必须设置，否则简历/JD/面试复盘全裸奔
APP_PASSWORD=

PORT=3000
