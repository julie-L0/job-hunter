{
  "name": "job-hunter",
  "version": "0.1.0",
  "description": "秋招管理系统",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/dev-server.js",
    "start": "node --env-file-if-exists=.env src/dev-server.js",
    "check": "node --env-file-if-exists=.env src/scripts/check.js",
    "test": "node --test",
    "init-tags": "node --env-file-if-exists=.env src/scripts/init-tags.js",
    "recompute": "node --env-file-if-exists=.env src/scripts/recompute.js",
    "migrate-companies": "node --env-file-if-exists=.env src/scripts/migrate-companies.js",
    "migrate-experiences": "node --env-file-if-exists=.env src/scripts/migrate-experiences.js"
  }
}
